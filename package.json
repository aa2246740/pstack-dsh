{
  "name": "pstack-dsh",
  "description": "DeepSeek Harness port of official pstack. Playbooks and principles are poteto's; only the harness call layer is rewritten.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "skills",
    "agents",
    "cordis.patch.yml",
    "cordis.yml",
    "dshx.yml",
    "HARNESS.md",
    "README.md",
    "TEST-PLAN.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.spec.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/pstack-dsh.git"
  },
  "homepage": "https://github.com/aa2246740/pstack-dsh",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pstack",
    "poteto-mode"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-agent": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-skill": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3"
  }
}
